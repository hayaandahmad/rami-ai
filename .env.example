# Server-only environment variables for Rami.
# Never prefix these with NEXT_PUBLIC_ — they must not reach the browser.

# Local development:
#   Copy this file to .env.local and fill in the real values.
#   .env.local is not committed to git.
#
# Production:
#   Set these in your hosting platform's environment variable settings.

# ── Google Sheets persistence (existing) ─────────────────────────────────────
# Google Apps Script Web App URL (ends in /exec).
RAMI_SHEETS_WEBHOOK_URL=

# Shared secret. Must match the value stored in the Apps Script project's
# Script Properties (key: RAMI_SHEETS_SECRET). Generate a long random string.
RAMI_SHEETS_SECRET=

# ── Local AI (Phase 1) ────────────────────────────────────────────────────────
# Ollama inference base URL. No secret required for local-only access.
# Default: http://localhost:11434 (set in config/model-manifest.json).
# Only override here if you run Ollama on a non-standard port or remote host.
# RAMI_OLLAMA_BASE_URL=http://localhost:11434

# ── Modal inference (optional development) ───────────────────────────────────
# local = LocalModelProvider (default). modal = ModalModelProvider (T4 / qwen3:8b).
RAMI_MODEL_PROVIDER=local
# Path to Python that has `modal` installed (repo-local venv recommended).
# RAMI_MODAL_PYTHON=.venv-modal\Scripts\python.exe
# RAMI_MODAL_BRIDGE=infra/modal-poc/bridge.py
# Development credit budget for ESTIMATED UI only (Modal billing is source of truth).
MODAL_DEV_CREDIT_BUDGET=1.00
# Official Modal T4 rate used for estimates.
MODAL_T4_USD_PER_SEC=0.000164
# Idle auto-stop while READY (seconds). Default 15 minutes.
RAMI_MODAL_IDLE_SEC=900
# Max warm session before forced stop unless extended (seconds). Default 2 hours.
RAMI_MODAL_MAX_SESSION_SEC=7200
# Extend Session adds this many seconds. Default 1 hour.
RAMI_MODAL_EXTEND_SEC=3600

# ── PostgreSQL (authoritative project persistence) ────────────────────────────
# Server-only. Never prefix with NEXT_PUBLIC_.
# Either set RAMI_DB_URL or the discrete fields below.
# RAMI_DB_URL=postgres://rami:rami@127.0.0.1:5432/rami
RAMI_DB_HOST=127.0.0.1
RAMI_DB_PORT=5432
RAMI_DB_NAME=rami
RAMI_DB_USER=rami
RAMI_DB_PASSWORD=
RAMI_DB_SSL=false
# Directory for pg_dump / pg_restore (must not be OneDrive-synced live PG data).
RAMI_DB_BACKUP_DIR=.rami-db-backups
# Optional deterministic FX overrides (Qwen never sets these).
# RAMI_FX_USD_JOD=0.71
# RAMI_FX_EUR_JOD=0.78
